# DeepHub AI — Environment Variables Template
# Copy this file to .env and fill in your actual values


# ============================================================
# App Config
# ============================================================
PORT=3001
VITE_API_URL=http://localhost:3001

# ============================================================
# AI Provider API Keys (at least one required)
# ============================================================
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
KIMI_API_KEY=your_kimi_api_key_here
DEFAULT_AI_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# Other API Keys
# ============================================================
VITE_NEWS_API_KEY=your_news_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# ============================================================
# JWT Auth
# ============================================================
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ============================================================
# AWS Configuration
# ============================================================
AWS_REGION=us-east-1

# For local development only — ECS uses IAM task role automatically (no keys needed)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ============================================================
# AWS S3 (File Storage)
# ============================================================
USE_AWS_S3=true
AWS_S3_BUCKET=your-s3-bucket-name

# ============================================================
# AWS DynamoDB (Database)
# ============================================================
USE_DYNAMODB=true
DYNAMODB_USERS_TABLE=DeepHub_Users
DYNAMODB_LESSONS_TABLE=DeepHub_NeuralLessons
DYNAMODB_ACTIVITY_LOGS_TABLE=DeepHub_ActivityLogs
DYNAMODB_CATALOG_TABLE=DeepHub_Catalog
DYNAMODB_SETTINGS_TABLE=DeepHub_Settings

# MongoDB — NOT USED when DynamoDB is active (leave as-is)
MONGO_URI=NOT_USED_DYNAMODB_ACTIVE
Client ID = 410846240599-rn1151u7b3aqegoegklc015obemna7mh.apps.googleusercontent.com
Client secret = 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