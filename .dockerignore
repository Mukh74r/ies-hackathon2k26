# DeepHub AI — Docker Build Ignore
# Prevents secrets and dev files from leaking into the Docker image

# Environment secrets — NEVER bake into the image
.env
.env.local
.env.*.local
secrets-payload.json

# Dev tooling bloat
node_modules
npm-debug.log*
yarn-debug.log*

# Frontend build output (copied from frontend-builder stage, not the source)
dist

# Local uploads (S3 handles storage in prod)
uploads/

# Git history
.git
.gitignore

# Developer IDE configs
.vscode
.agent

# Test & local DB artifacts
*.zip
stack_outputs*.json
stack_status*.txt
eng.traineddata
test-kimi.js
test_server.ts
backend/
